  {"id": "phrase_fuzz_corpus",    "label": "fuzz corpus",                "category": "specific_technique", "regex": "(?<![A-Za-z0-9])fuzz[\\s-]+corp(?:us|ora|uses)(?![A-Za-z0-9])", "flags": "IGNORECASE",
