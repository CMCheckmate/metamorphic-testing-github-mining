[
  {"_note": "Keyword set v2 (2026-10-11): explicit technique phrases only, mirroring the kept search keywords (team decision: no tool/library/API keywords; 'fuzzing' kept because results found only by it are mostly about fuzz testing). Same rules as the MT v2 set: ASCII-only boundaries, space-or-hyphen separators, plurals, split_first/split_second for a wrapped phrase. The X-fuzzing concept phrases always contain the word 'fuzzing', so they are subset_of phrase_fuzzing (listed per keyword, excluded from totals). The previous library/API set is kept in inputs/archive/fuzz_analysis_keywords_v1_libraries.json."},

  {"id": "phrase_fuzz_test",      "label": "fuzz test(ing)",             "category": "specific_technique", "regex": "(?<![A-Za-z0-9])fuzz[\\s-]+test(?:ing|s|ers?)?(?![A-Za-z0-9])", "flags": "IGNORECASE",
