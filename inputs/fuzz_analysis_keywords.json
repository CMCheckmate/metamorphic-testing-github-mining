  {"id": "phrase_grammar_based",  "label": "grammar-based fuzzing",      "category": "specific_technique", "regex": "(?<![A-Za-z0-9])grammar[\\s-]+based[\\s-]+fuzzing(?![A-Za-z0-9])",      "flags": "IGNORECASE", "subset_of": "phrase_fuzzing"},
  {"id": "phrase_structure_aware","label": "structure-aware fuzzing",    "category": "specific_technique", "regex": "(?<![A-Za-z0-9])structure[\\s-]+aware[\\s-]+fuzzing(?![A-Za-z0-9])",    "flags": "IGNORECASE", "subset_of": "phrase_fuzzing"},

