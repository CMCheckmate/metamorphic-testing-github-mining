  {"id": "phrase_coverage_guided","label": "coverage-guided fuzzing",    "category": "specific_technique", "regex": "(?<![A-Za-z0-9])coverage[\\s-]+guided[\\s-]+fuzzing(?![A-Za-z0-9])", "flags": "IGNORECASE", "subset_of": "phrase_fuzzing"},
