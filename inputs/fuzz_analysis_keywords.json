  {"id": "phrase_fuzz_harness",   "label": "fuzz harness",               "category": "specific_technique", "regex": "(?<![A-Za-z0-9])fuzz[\\s-]+harness(?:es)?(?![A-Za-z0-9])", "flags": "IGNORECASE",
