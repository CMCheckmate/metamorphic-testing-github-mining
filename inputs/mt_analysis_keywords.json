[
  {"id": "general_assert",     "label": "assert statement",       "category": "general_test",  "regex": "\\bassert\\b",                              "flags": "IGNORECASE"},
  {"id": "general_test_word",  "label": "test (word)",            "category": "general_test",  "regex": "\\btest\\b",                                "flags": "IGNORECASE"},
  {"id": "general_unittest",   "label": "unittest",               "category": "general_test",  "regex": "\\bunittest\\b",                            "flags": "IGNORECASE"},
  {"id": "general_testcase",   "label": "TestCase",               "category": "general_test",  "regex": "\\bTestCase\\b"},
  {"id": "general_verify",     "label": "verify / check",         "category": "general_test",  "regex": "\\b(?:verify|check_result|check_output)\\b","flags": "IGNORECASE"},

  {"id": "phrase_mt",          "label": "metamorphic test(ing)",  "category": "specific_technique", "regex": "\\bmetamorphic\\s+test(?:ing|s)?\\b",    "flags": "IGNORECASE"},
  {"id": "phrase_mr",          "label": "metamorphic relation",   "category": "specific_technique", "regex": "\\bmetamorphic\\s+relation(?:s|ship|ships)?\\b", "flags": "IGNORECASE"},
  {"id": "phrase_mp",          "label": "metamorphic property",   "category": "specific_technique", "regex": "\\bmetamorphic\\s+propert(?:y|ies)\\b",  "flags": "IGNORECASE"},
  {"id": "phrase_mg",          "label": "metamorphic group",      "category": "specific_technique", "regex": "\\bmetamorphic\\s+groups?\\b",            "flags": "IGNORECASE"},
  {"id": "phrase_moracle",     "label": "metamorphic oracle",     "category": "specific_technique", "regex": "\\bmetamorphic\\s+oracle\\b",             "flags": "IGNORECASE"},

  {"id": "class_mt",           "label": "class MetamorphicTest",  "category": "specific_technique", "regex": "\\bMetamorphicTest\\w*\\b"},
  {"id": "class_mr",           "label": "class MetamorphicRelation","category": "specific_technique","regex": "\\bMetamorphicRelation\\w*\\b"},
  {"id": "decorator_mt",       "label": "@metamorphic decorator", "category": "specific_technique", "regex": "@metamorphic\\b"},

  {"id": "ident_mr_snake",     "label": "metamorphic_relation (snake_case)", "category": "specific_technique", "regex": "\\bmetamorphic_relation\\w*\\b"},
  {"id": "ident_mt_snake",     "label": "metamorphic_test (snake_case)",     "category": "specific_technique", "regex": "\\bmetamorphic_test\\w*\\b"},

  {"id": "abbrev_MT",          "label": "abbreviation MT",        "category": "specific_technique", "regex": "(?<![A-Za-z0-9_])MT(?![A-Za-z0-9_])"},
  {"id": "abbrev_MR",          "label": "abbreviation MR",        "category": "specific_technique", "regex": "(?<![A-Za-z0-9_])MR(?![A-Za-z0-9_])"},

  {"id": "string_mt",          "label": "string literal: metamorphic test", "category": "specific_technique", "regex": "\"[Mm]etamorphic\\s+[Tt]est(?:ing|s)?\""},
  {"id": "string_mr",          "label": "string literal: metamorphic relation","category": "specific_technique","regex": "\"[Mm]etamorphic\\s+[Rr]elation(?:s|ship|ships)?\""},

  {"id": "comment_mt",         "label": "comment: metamorphic test","category": "specific_technique","regex": "(?:#|//).*\\bmetamorphic\\s+test(?:ing|s)?\\b","flags": "IGNORECASE"},
  {"id": "comment_mr",         "label": "comment: metamorphic relation","category":"specific_technique","regex":"(?:#|//).*\\bmetamorphic\\s+relation(?:s|ship|ships)?\\b","flags":"IGNORECASE"},

  {"id": "tfd_test_py",        "label": "test_*.py or *_test.py filename",   "category": "test_file_detection", "regex": "^test_.+\\.py$|^.+_test\\.py$",   "apply_to": "filename"},
  {"id": "tfd_test_go",        "label": "*_test.go filename",                 "category": "test_file_detection", "regex": "^.+_test\\.go$",                   "apply_to": "filename"},
  {"id": "tfd_test_java",      "label": "*Test.java filename",                "category": "test_file_detection", "regex": "^.+Test\\.java$",                  "apply_to": "filename"},
  {"id": "tfd_test_kt",        "label": "*Test.kt filename",                  "category": "test_file_detection", "regex": "^.+Test\\.kt$",                    "apply_to": "filename"},
  {"id": "tfd_spec_ts",        "label": "*.spec.ts filename",                 "category": "test_file_detection", "regex": "^.+\\.spec\\.tsx?$",               "apply_to": "filename"},
  {"id": "tfd_spec_rb",        "label": "*_spec.rb filename",                 "category": "test_file_detection", "regex": "^.+_spec\\.rb$",                   "apply_to": "filename"},
  {"id": "tfd_spec_js",        "label": "*.spec.js filename",                 "category": "test_file_detection", "regex": "^.+\\.spec\\.jsx?$",               "apply_to": "filename"},

  {"id": "tfd_import_pytest",  "label": "import pytest (content)",            "category": "test_file_detection", "regex": "^import pytest$|^from pytest",     "apply_to": "content", "language": "Python"},
  {"id": "tfd_import_junit",   "label": "import org.junit (content)",         "category": "test_file_detection", "regex": "import org\\.junit",               "apply_to": "content", "language": "Java"},
  {"id": "tfd_import_junit_kt","label": "import org.junit (Kotlin content)",  "category": "test_file_detection", "regex": "import org\\.junit",               "apply_to": "content", "language": "Kotlin"},
  {"id": "tfd_cfg_test_rust",  "label": "#[cfg(test)] (Rust content)",        "category": "test_file_detection", "regex": "#\\[cfg\\(test\\)\\]",             "apply_to": "content", "language": "Rust"},
  {"id": "tfd_ann_test_java",  "label": "@Test annotation (Java content)",    "category": "test_file_detection", "regex": "@Test\\b",                         "apply_to": "content", "language": "Java"},
  {"id": "tfd_ann_test_kt",    "label": "@Test annotation (Kotlin content)",  "category": "test_file_detection", "regex": "@Test\\b",                         "apply_to": "content", "language": "Kotlin"}
]
