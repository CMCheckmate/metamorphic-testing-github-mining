# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens
# Scopes needed: public_repo (read:org optional for org-level search)
GITHUB_TOKEN=ghp_your_token_here

# Optional: comma-separated list of GitHub usernames/orgs to exclude from results
# EXCLUDE_OWNERS=

# Optional: path to store cloned repos (default: ./repos/)
# REPOS_DIR=repos

# Optional: path to store search results (default: ./results/)
# RESULTS_DIR=results
